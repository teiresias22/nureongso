# --- collector (collector/.env 또는 셸 환경변수) ---
# Supabase > Project Settings > Database > Connection string > URI (Session pooler 권장)
# 비밀번호에 @ 같은 특수문자가 있으면 URI 가 깨진다. 그때는 키워드 형식을 쓴다:
#   DATABASE_URL="host=... port=5432 dbname=postgres user=... password='...'"
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 필수. 키가 없으면 서버가 페이지네이션을 무시하고 첫 5행만 반복해서 돌려준다.
# https://open.assembly.go.kr 회원가입 > 마이페이지 > 인증키 발급 (무료)
ASSEMBLY_API_KEY=
# 선관위. https://www.data.go.kr 에서 활용신청, 무료. 디코딩된 키를 넣는다.
DATA_GO_KR_KEY=

# --- LLM (공약 파싱 / 이행 판정) ---
# gemini(기본) | anthropic | ollama
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey — 카드 없이 무료. 모델당 하루 500건.
# 쉼표로 여러 개를 넣으면 한도에 걸릴 때 다음 키로 자동으로 넘어간다.
# 단, 일일 한도는 키가 아니라 '구글 클라우드 프로젝트' 단위다. 같은 프로젝트에서
# 키만 더 뽑으면 한도를 같이 쓰므로 소용없다. 다른 프로젝트나 다른 계정이어야 한다.
#   GEMINI_API_KEY=AIza...첫번째,AIza...두번째
GEMINI_API_KEY=
# 비워두면 models.list 로 쓸 수 있는 모델을 알아서 고른다.
GEMINI_MODEL=
# LLM_PROVIDER=anthropic 일 때만 (유료)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# LLM_PROVIDER=ollama 일 때만 (로컬, 한도 없음, 품질은 떨어짐)
OLLAMA_MODEL=

# --- web (로컬은 web/.env.local, 배포는 Vercel 환경변수) ---
# Supabase > Project Settings > API. anon 키는 공개해도 된다 —
# 모든 테이블이 RLS 로 읽기 전용이고 쓰기 정책이 하나도 없다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 배포 주소. sitemap 과 og:image 의 절대 URL 에 쓴다.
# Vercel 은 VERCEL_PROJECT_PRODUCTION_URL 로 자동으로 잡아주므로, 직접 산 도메인을
# 붙일 때만 설정하면 된다. 로컬 기본값은 http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# 네이버 서치어드바이저 소유 확인. https://searchadvisor.naver.com → 사이트 등록 →
# HTML 태그를 고르고 content="..." 안의 값만 넣는다 (태그 전체가 아니다).
# 값이 없으면 태그가 아예 안 나간다. 구글 토큰은 공개값이라 layout.tsx 에 그냥 두었다.
NAVER_SITE_VERIFICATION=
