# 실제 값은 .env 에 넣는다. .env 는 .gitignore 에 있어 올라가지 않는다.
#   brew install dotenvx/brew/dotenvx
#   cp .env.example .env    →  값 채우기  →  dotenvx encrypt
#   dotenvx run -- .venv/bin/python judge.py decide      실행 (값을 풀어 환경변수로 넣는다)
#   dotenvx get KEY / dotenvx set KEY 값                   보기 / 바꾸기
# 개인키는 OS 키체인에 있다(맥: 키체인 접근 > 서비스 'dotenvx'). .env.keys 파일이 생기면
# 그것도 개인키다 — .gitignore 의 collector/.env* 규칙에 걸려 올라가지 않는다.
# 워크플로에서 도는 것은 GitHub Actions secrets 에도 같은 이름으로 넣어야 한다.

# Supabase 접속 문자열 (전부 필요)
DATABASE_URL=

# 열린국회정보 — 법안·표결. https://open.assembly.go.kr
ASSEMBLY_API_KEY=

# 공공데이터포털 — 선관위(당선인·공약), 나라장터 입찰공고.
# 포털이 인코딩/디코딩 두 가지를 주는데 어느 쪽이든 된다(수집기가 풀어 쓴다).
# https://www.data.go.kr
DATA_GO_KR_KEY=

# 법제처 국가법령정보 — 자치법규, 선거구구역표. 가입 이메일의 아이디 앞부분.
# (hong@gmail.com 이면 hong) 신청·승인 없이 바로 된다. https://open.law.go.kr
LAW_OC=

# Gemini — 공약 분류와 근거 대조. 한도는 키가 아니라 GCP 프로젝트 단위라,
# 두 개를 쓰려면 서로 다른 프로젝트의 키여야 한다. 쉼표로 이어 적는다.
GEMINI_API_KEY=

# 주간 기록 메일(digest.py). web/.env.local 의 RESEND_API_KEY·MAIL_FROM 과 같은 값.
# Resend(https://resend.com) API 키와, Resend 에서 확인한 도메인의 보내는 사람. 비우면 digest.py 는 건너뛴다.
RESEND_API_KEY=
MAIL_FROM=

# --- 아래는 선택. LLM 을 바꿀 때만 ---
# gemini(기본, 무료) | anthropic(유료) | ollama(로컬, 한도 없음, 품질은 떨어짐)
LLM_PROVIDER=gemini
# 비워두면 models.list 로 쓸 수 있는 모델을 알아서 고른다(로컬 실행용).
# 정기 워크플로는 고정한다 — evidence.yml gemini-3.1-flash-lite. 바꾸는 것은 따로 커밋.
GEMINI_MODEL=
# 제미나이 키를 다 돌려도 일일 한도가 차거나 과부하 대기가 LLM_OVERLOAD_WAIT 초(기본 600)를 넘으면
# 이 실행의 나머지를 Claude 로 넘긴다. 먼저 Claude Code CLI(구독 토큰, `claude setup-token`), 없으면 API(유료).
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_MODEL=sonnet   LLM_OVERLOAD_WAIT=600
# ANTHROPIC_MODEL=claude-opus-5-5   ANTHROPIC_EFFORT=low   ANTHROPIC_MAX_CALLS=300
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_MODEL=
# 기본 http://localhost:11434
OLLAMA_HOST=
