# 실제 값은 .env 에 넣는다. .env 는 .gitignore 에 있어 올라가지 않는다.
#   cp .env.example .env
# 워크플로에서 도는 것은 GitHub Actions secrets 에도 같은 이름으로 넣어야 한다.

# Supabase 접속 문자열 (전부 필요)
DATABASE_URL=

# 열린국회정보 — 법안·표결. https://open.assembly.go.kr
ASSEMBLY_API_KEY=

# 공공데이터포털 — 선관위(당선인·공약), 나라장터 입찰공고.
# 포털이 인코딩/디코딩 두 가지를 주는데 어느 쪽이든 된다(수집기가 풀어 쓴다).
# https://www.data.go.kr
DATA_GO_KR_KEY=

# 법제처 국가법령정보 — 자치법규, 선거구구역표. 가입 이메일의 아이디 앞부분.
# (hong@gmail.com 이면 hong) 신청·승인 없이 바로 된다. https://open.law.go.kr
LAW_OC=

# 지방재정365 — 지자체 예산사업. https://lofin365.go.kr
LOFIN_KEY=

# 열린재정 — 중앙정부 세부사업(국비). 국회의원 공약의 예산 근거에 쓴다.
# https://openfiscaldata.go.kr
OPENFISCAL_KEY=

# Gemini — 공약 분류와 근거 대조. 한도는 키가 아니라 GCP 프로젝트 단위라,
# 두 개를 쓰려면 서로 다른 프로젝트의 키여야 한다. 쉼표로 이어 적는다.
GEMINI_API_KEY=
