# 실제 값은 .env.local 에 넣는다 (gitignore). Vercel 에는 같은 이름으로 환경변수를 넣는다.
#   cp .env.example .env.local  →  값 채우기  →  dotenvx encrypt -f .env.local
#   npm run dev 가 dotenvx run 을 거치므로 그대로 쓰면 된다.

# Supabase 프로젝트 설정 > API. anon 키는 공개해도 된다 —
# 모든 테이블이 RLS 로 읽기 전용이고 쓰기 정책이 하나도 없다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포 주소. sitemap 과 og:image 의 절대 URL 에 쓴다. 비우면 Vercel 의
# VERCEL_PROJECT_PRODUCTION_URL, 로컬은 http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# 네이버 서치어드바이저 소유 확인 — HTML 태그의 content="..." 안의 값만. 비우면 태그가 안 나간다.
# 구글 토큰은 공개값이라 layout.tsx 에 그냥 두었다.
NAVER_SITE_VERIFICATION=

# --- 주간 기록 메일 (app/api/subscription/route.ts) ---
# 셋이 다 있어야 /my 에 구독 폼이 뜬다(lib/subscription.ts subscriptionOn). 비우면 꺼진다.
# 서버 전용(NEXT_PUBLIC_ 아님). RLS 를 우회하는 키라 route.ts 밖에서 읽지 않는다.
# Supabase 프로젝트 설정 > API > service_role. 구독 신청·확인·해지 함수만 부른다.
SUPABASE_SERVICE_ROLE_KEY=
# Resend(https://resend.com) API 키. 확인 메일은 web 이, 주간 메일은 collector/digest.py 가 같은 키로 보낸다.
RESEND_API_KEY=
# 보내는 사람. Resend 에서 확인한 도메인이어야 한다. 예: 누렁소검은소 <digest@mail.example.com>
MAIL_FROM=
